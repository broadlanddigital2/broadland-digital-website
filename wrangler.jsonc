{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "broadland-digital-website",
  "compatibility_date": "2026-10-01",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    // The worker runs first for pages (CRM pages can take over an address, old WordPress addresses redirect);
    // styles and scripts go straight to the files.
    "run_worker_first": ["/*", "!/_static/*"],
    "not_found_handling": "404-page",
    "html_handling": "force-trailing-slash"
  },
  "vars": {
    // Where /wp-content/uploads files not yet copied into the repo are fetched from. Point it at the old WordPress
    // host's own address (e.g. its temporary domain) before broadlanddigital.co.uk is moved to this worker.
    "OLD_SITE_ORIGIN": "https://broadlanddigital.co.uk",
    // Every website enquiry is also emailed here (Boxly's inbox, as the old contact form did) until the CRM's Meta app
    // is approved. Delete this line to stop. Needs the secret SENDGRID_API_KEY (Settings → Variables and Secrets).
    "BOXLY_EMAIL": "8420d20d-9c4a-4a5e-ae76-424a97a3e249@webform.boxly.ai"
  },
  // Live: broadlanddigital.co.uk and www are served by this worker (www redirects to the bare domain in
  // worker/index.js). The DNS records stay as they are (proxied); to go back to WordPress, remove these routes.
  // Keep the preview address (broadland-digital-website.justin-b8f.workers.dev) on: with routes set, deploys
  // otherwise switch it off.
  "workers_dev": true,
  "routes": [
    { "pattern": "broadlanddigital.co.uk/*", "zone_name": "broadlanddigital.co.uk" },
    { "pattern": "www.broadlanddigital.co.uk/*", "zone_name": "broadlanddigital.co.uk" }
  ],
  "observability": { "enabled": true },
  "keep_vars": true
}
